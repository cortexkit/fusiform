#!/bin/sh
# Refuse a push that CI would fail for reasons a local check can see in under a
# second: a committed lock that is not the validated one, unformatted code, or
# a lock that does not resolve.
#
# WHY A HOOK RATHER THAN A HABIT
#
# "My change cannot need a cargo gate" is the wrong question. The gate is about
# the TREE being pushed, not the diff, so a shell-only commit still rides
# whatever lock and formatting the tree carries. A rule in prose protects its
# reader once; this runs every time.
#
# Invoked through AFT's managed dispatcher, which walks to `$repo_root/.githooks`
# after the git-dir hooks. Tracked in the repo so a fresh clone has it.
#
# RE-PROVING THIS HOOK IS WIRED needs a precondition nobody states:
#
#     printf '#!/bin/sh\necho REACHED >&2\nexit 1\n' > .githooks/pre-push
#     git push origin HEAD:refs/heads/probe-hook-reach     <- a NEW ref
#
# The new ref is load-bearing. Push something already at origin and git does no
# work, never invokes the hook, and prints nothing — which reads exactly like a
# hook that ran and passed.
set -eu

if ! command -v cargo > /dev/null 2>&1; then
    # No toolchain: a docs-only clone can still push. Refusing here would gate
    # git on a dependency this check is merely convenient to have.
    exit 0
fi

# The lock being PUSHED is the one CI resolves, and it is not necessarily the
# one validated below. A gate run without --locked rewrites the lock; stage
# explicit paths afterwards and the working tree resolves while the commit
# carries the old pin. Equality is the whole proof: if the committed bytes are
# the validated bytes, the checks below cover the push.
if ! cmp -s "$(git rev-parse --show-toplevel)/Cargo.lock" /dev/stdin <<CMPEOF
$(git show HEAD:Cargo.lock)
CMPEOF
then
    echo "pre-push refused: the committed Cargo.lock is not the one in the tree" >&2
    echo >&2
    echo "  CI resolves the COMMIT, so validating this working tree proves" >&2
    echo "  nothing about the push. The usual cause is a gate run without" >&2
    echo "  --locked, which rewrites the lock, followed by staging explicit" >&2
    echo "  paths that leave the rewrite behind." >&2
    echo >&2
    echo "      git diff HEAD -- Cargo.lock" >&2
    echo >&2
    exit 1
fi

# `cargo fmt --all -- --check` is the first thing ci.yml runs. Cheap enough to be
# unconditional: it reads files and compares, no build. --check rather than
# rewriting, because a hook that edits the tree during a push would format files
# that are not in the commit being pushed.
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo "pre-push refused: formatting" >&2
    echo >&2
    echo "  ci.yml runs \`cargo fmt --all -- --check\` before anything else, so" >&2
    echo "  this fails there rather than here. Fix:" >&2
    echo >&2
    echo "      cargo fmt --all" >&2
    echo >&2
    echo "  Then re-stage the files it touched — explicit paths, not -A." >&2
    exit 1
fi

# Does the lock resolve against the manifests. Every dependency is a crates.io
# version pinned in the lock, so this answers the same question CI's --locked
# build does, in a fraction of a second and without compiling anything.
if ! cargo metadata --locked --offline --format-version 1 > /dev/null 2>&1; then
    echo "pre-push refused: Cargo.lock does not resolve --locked" >&2
    echo >&2
    echo "  A manifest changed without the lock following it. CI builds with" >&2
    echo "  --locked, so the push would fail there. Update each dependency" >&2
    echo "  whose version you changed, by name, and gate on it:" >&2
    echo >&2
    echo "      cargo update -p <crate> [-p <crate> ...]" >&2
    echo "      cargo t --workspace && cargo c" >&2
    echo >&2
    exit 1
fi
