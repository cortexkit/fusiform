#!/bin/sh
# Refuse a push that CI would fail for reasons a local check can see in under a
# second: unformatted code, a lock that does not resolve, or a dependency
# resolved from a local path outside the repository.
#
# WHY A HOOK RATHER THAN A HABIT
#
# "My change cannot need a cargo gate" is the wrong question. The gate is about
# the TREE being pushed, not the diff, so a shell-only commit still rides
# whatever lock and formatting the tree carries. A rule in prose protects its
# reader once; this runs every time.
#
# Invoked through AFT's managed dispatcher, which walks to `$repo_root/.githooks`
# after the git-dir hooks. Tracked in the repo so a fresh clone has it.
#
# RE-PROVING THIS HOOK IS WIRED needs a precondition nobody states:
#
#     printf '#!/bin/sh\necho REACHED >&2\nexit 1\n' > .githooks/pre-push
#     git push origin HEAD:refs/heads/probe-hook-reach     <- a NEW ref
#
# The new ref is load-bearing. Push something already at origin and git does no
# work, never invokes the hook, and prints nothing — which reads exactly like a
# hook that ran and passed.
set -eu

if ! command -v cargo > /dev/null 2>&1; then
    # No toolchain: a docs-only clone can still push. Refusing here would gate
    # git on a dependency this check is merely convenient to have.
    exit 0
fi

repo_env=$(git rev-parse --local-env-vars)
scratch=$(mktemp -d)
tree="$scratch/tree"
finished=0
cleanup() {
    rc=$?
    if [ -e "$tree/.git" ]; then
        git worktree remove --force "$tree"
    fi
    rm -rf "$scratch"
    if [ "$rc" -eq 0 ] && [ "$finished" -ne 1 ]; then
        exit 1
    fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

check_tree() (
    # Git's inherited repository variables can point tools back at the tree
    # being pushed from rather than the commit checked out for validation.
    unset $repo_env
    cd "$tree" || exit 1

# `cargo fmt --all -- --check` is the first thing ci.yml runs. Cheap enough to be
# unconditional: it reads files and compares, no build. --check rather than
# rewriting, because a hook that edits the tree during a push would format files
# that are not in the commit being pushed.
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo "pre-push refused: formatting" >&2
    echo >&2
    echo "  ci.yml runs \`cargo fmt --all -- --check\` before anything else, so" >&2
    echo "  this fails there rather than here. Fix:" >&2
    echo >&2
    echo "      cargo fmt --all" >&2
    echo >&2
    echo "  Then re-stage the files it touched — explicit paths, not -A." >&2
    exit 1
fi

# Does the lock resolve against the manifests. Every dependency is a crates.io
# version pinned in the lock, so this answers the same question CI's --locked
# build does, in a fraction of a second and without compiling anything.
#
# --offline also fails when a crate the lock pins has not been downloaded here
# yet (a lock just moved by `cargo update` on another machine, or a cleared
# cache). That is not a stale lock, so print cargo's own reason rather than
# guess which of the two it is.
if ! metadata_err=$(cargo metadata --locked --offline --format-version 1 2>&1 > /dev/null); then
    echo "pre-push refused: Cargo.lock does not resolve --locked offline" >&2
    echo >&2
    printf '%s\n' "$metadata_err" | sed -n '1,6s/^/  cargo: /p' >&2
    echo >&2
    echo "  If cargo could not download a crate, fetch it once and push again:" >&2
    echo >&2
    echo "      cargo fetch --locked" >&2
    echo >&2
    echo "  If a manifest changed without the lock following it, update each" >&2
    echo "  dependency whose version you changed, by name, and gate on it:" >&2
    echo >&2
    echo "      cargo update -p <crate> [-p <crate> ...]" >&2
    echo "      cargo t --workspace && cargo c" >&2
    echo >&2
    exit 1
fi

# No dependency may resolve from a path outside this repo. A sibling path dep
# goes stale on every sibling release; see the script for why.
if ! ./scripts/no-outside-path-deps.sh; then
    echo "pre-push refused: a dependency resolves from outside this repository" >&2
    echo >&2
    echo "  Take it from crates.io, or pin a git rev if it is unpublished." >&2
    exit 1
fi
)

checked=' '
while read -r local_ref local_sha remote_ref remote_sha; do
    # Ref deletions have no local tree to check. Several pushed refs can point
    # at the same commit, including annotated tags; validate each commit once.
    [ "$local_ref" != '(delete)' ] || continue
    commit=$(git rev-parse --verify "$local_sha^{commit}") || exit 1
    case "$checked" in *" $commit "*) continue ;; esac

    # A push can name any ref, and unstaged edits can mask a defect in HEAD.
    # Check the committed tree without running a post-checkout hook that could
    # alter the files being validated.
    git -c core.hooksPath=/dev/null worktree add --quiet --detach "$tree" "$commit" </dev/null
    if ! check_tree </dev/null; then
        echo "  Commit $commit ($local_ref -> $remote_ref) did not pass." >&2
        exit 1
    fi
    git worktree remove --force "$tree"
    checked="$checked$commit "
done
finished=1
